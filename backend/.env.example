APP_ENV=development
DATABASE_URL=postgresql+psycopg://controlplane:controlplane@db:5432/controlplane
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173"]
DEV_MOCK_LLM=true
GROQ_API_KEY=
GEMINI_API_KEY=
MAX_PROMPT_CHARS=12000
AUTO_CREATE_TABLES=true
DETECTOR_UPGRADES=false
LLM_TIMEOUT_SECONDS=30
SESSION_RISK_DECAY_MINUTES=30
LOG_LEVEL=INFO
